# Copy this file to .env and fill it in:  copy .env.example .env
# Values: Firebase console > Project settings > Your apps > Brave Cards (web app) > SDK setup and configuration > Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=bravecards.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bravecards
VITE_FIREBASE_STORAGE_BUCKET=bravecards.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
